<Window x:Class="TieLiteDesktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TieLiteDesktop"
        Width="1440" Height="920" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#0B0C10"
        UseLayoutRounding="True"
        AllowDrop="True"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="8" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="WindowRoot" Background="{DynamicResource AppBackground}">
    <Image x:Name="AppBackgroundImage" Stretch="UniformToFill" Visibility="Collapsed"/>
    <Border x:Name="AppBackgroundScrim" Background="#55000000" Visibility="Collapsed"/>
<Grid x:Name="RootGrid" Background="{DynamicResource AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= sidebar ================= -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Width="256" Background="{DynamicResource SidebarBackground}" ClipToBounds="True"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- brand -->
                <Grid DockPanel.Dock="Top" Height="66" Background="Transparent"
                      MouseLeftButtonDown="BrandArea_MouseLeftButtonDown">
                    <StackPanel x:Name="BrandStack" Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                        <Border x:Name="BrandLogo" Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentGradient}">
                            <TextBlock Text="贴" Foreground="White" FontSize="17" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel x:Name="BrandText" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TieLite" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="桌面版" FontSize="10.5" Foreground="{DynamicResource TextTertiary}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="SidebarToggle" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,5,0" Width="26" Height="26" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" ToolTip="收起侧栏" Click="SidebarToggle_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ToggleBg" CornerRadius="7" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ToggleBg" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="SidebarToggleGlyph" Text="&#x00AB;" FontFamily="{DynamicResource UiFont}"
                                   FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform x:Name="SidebarArrowRotate" Angle="0"/>
                                    <TranslateTransform x:Name="SidebarArrowShift" X="0"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                </Grid>

                <!-- user card (bottom) -->
                <Border x:Name="UserCard" DockPanel.Dock="Bottom" Margin="14,6,14,14" CornerRadius="14" Padding="10"
                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="UserCard_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="UserAvatar" Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                Background="{DynamicResource SurfaceAlt}"/>
                        <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameText" Text="未登录" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="UserSubText" Text="登录后可收藏、回复" FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock x:Name="UserChevron" Grid.Column="2" Text="&#xE76C;" FontFamily="{DynamicResource IconFont}"
                                   FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- search -->
                <Border x:Name="SidebarSearch" DockPanel.Dock="Top" Margin="14,2,14,10" Height="38" CornerRadius="11"
                        Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="SearchBox_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{DynamicResource IconFont}"
                                   FontSize="13" Margin="12,0,7,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiary}"/>
                        <TextBlock Grid.Column="1" Text="搜索贴吧 / 帖子" FontSize="12.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiary}"/>
                    </Grid>
                </Border>

                <!-- nav -->
                <StackPanel x:Name="SidebarNav" DockPanel.Dock="Top" Margin="12,0,12,6">
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" Tag="&#xE80F;"
                                 Content="发现" GroupName="Nav" IsChecked="True" Click="NavHome_Click"/>
                    <RadioButton x:Name="NavMessages" Style="{StaticResource NavButton}" Tag="&#xE8BD;"
                                 Content="消息" GroupName="Nav" Click="NavMessages_Click"/>
                    <RadioButton x:Name="NavUserLookup" Style="{StaticResource NavButton}" Tag="&#xE77B;"
                                 Content="查人" GroupName="Nav" Click="NavUserLookup_Click"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;"
                                 Content="设置" GroupName="Nav" Click="NavSettings_Click"/>
                    <RadioButton x:Name="NavHistory" Style="{StaticResource NavButton}" Tag="&#xE81C;"
                                 Content="浏览历史" GroupName="Nav" Click="NavHistory_Click"/>
                    <RadioButton x:Name="NavFavorites" Style="{StaticResource NavButton}" Tag="&#xE734;"
                                 Content="收藏的帖子" GroupName="Nav" Click="NavFavorites_Click"/>
                    <RadioButton x:Name="NavCached" Style="{StaticResource NavButton}" Tag="&#xE74E;"
                                 Content="缓存的帖子" GroupName="Nav" Click="NavCached_Click"/>
                    <RadioButton x:Name="NavFollowed" Style="{StaticResource NavButton}" Tag="&#xE902;"
                                 Content="我关注的吧" GroupName="Nav" Click="NavFollowed_Click"/>
                    <RadioButton x:Name="NavJump" Style="{StaticResource NavButton}" Tag="&#xE8AB;"
                                 Content="一键跳转" GroupName="Nav" Click="NavJump_Click"/>
                </StackPanel>

                <!-- forums + hot topics -->
                <ScrollViewer x:Name="ForumsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,4,0,0">
                    <StackPanel>
                        <Grid Margin="20,6,16,6">
                            <TextBlock x:Name="ForumsHeader" Text="热门贴吧" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                            <Button x:Name="RefreshForumsButton" Style="{StaticResource IconButton}"
                                    Width="24" Height="24" HorizontalAlignment="Right"
                                    ToolTip="刷新推荐" Click="RefreshForums_Click">
                                <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource IconFont}" FontSize="11"/>
                            </Button>
                        </Grid>
                        <WrapPanel x:Name="ForumsPanel" Margin="12,0,10,4"/>

                        <Grid x:Name="TopicsHeader" Margin="20,14,16,6" Visibility="Collapsed">
                            <TextBlock Text="最有料热点" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE945;" FontFamily="{DynamicResource IconFont}" FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel x:Name="TopicsPanel" Margin="12,0,12,10" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= main ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Background="{DynamicResource AppBackground}"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource IconButton}"
                        Margin="16,0,0,0" Visibility="Collapsed" ToolTip="返回" Click="Back_Click">
                    <TextBlock Text="&#xE72B;" FontFamily="{DynamicResource IconFont}" FontSize="15"/>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitleText" Text="发现" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border x:Name="PageSubtitleChip" Style="{StaticResource Chip}" Margin="10,0,0,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="PageSubtitleText" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                    <Button x:Name="LockButton" Style="{StaticResource IconButton}" Margin="0,0,2,0" ToolTip="锁定应用" Visibility="Collapsed" Click="Lock_Click">
                        <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource IconFont}" FontSize="14"/>
                    </Button>
                    <Button x:Name="RecycleButton" Style="{StaticResource IconButton}" Margin="0,0,2,0" ToolTip="回收站" Click="Recycle_Click">
                        <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="14"/>
                    </Button>
                    <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Margin="0,0,2,0" ToolTip="刷新" Click="Refresh_Click">
                        <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource IconFont}" FontSize="14"/>
                    </Button>
                    <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Margin="0,0,14,0" ToolTip="切换深色模式" Click="Theme_Click">
                        <TextBlock Text="&#xE793;" FontFamily="{DynamicResource IconFont}" FontSize="14"/>
                    </Button>
                    <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}" ToolTip="最小化" Click="Minimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="{DynamicResource IconFont}" FontSize="10"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" ToolTip="最大化" Click="Maximize_Click">
                        <TextBlock Text="&#xE922;" FontFamily="{DynamicResource IconFont}" FontSize="10"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseWindowButton}" ToolTip="关闭" Click="Close_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource IconFont}" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- page host -->
            <Grid Grid.Row="1" x:Name="PageContainer" Background="{DynamicResource AppBackground}">
                <ContentControl x:Name="PageHost"/>
            </Grid>
        </Grid>

        <!-- resize grip -->
        <Thumb x:Name="ResizeGrip" Grid.Column="0" Grid.ColumnSpan="2" Width="20" Height="20"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
               DragDelta="ResizeGrip_DragDelta" Background="Transparent">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 4 18 L 18 4 M 9 18 L 18 9 M 14 18 L 18 14"
                              Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- toast -->
        <Border x:Name="Toast" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="10" Padding="16,9" Opacity="0">
            <TextBlock x:Name="ToastText" FontSize="13"/>
        </Border>
    </Grid>

<Border x:Name="LockOverlay" Background="{DynamicResource AppBackground}" Panel.ZIndex="1001" Visibility="Collapsed">
    <Grid>
        <Image x:Name="LockBackdrop" Stretch="UniformToFill" Visibility="Collapsed"/>
        <Border x:Name="LockScrim" Background="#66000000" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0">
            <Button x:Name="LockMinButton" Style="{StaticResource IconButton}" ToolTip="最小化" Click="LockMinimize_Click">
                <TextBlock Text="&#xE921;" FontFamily="{DynamicResource IconFont}" FontSize="13"/>
            </Button>
            <Button x:Name="LockMaxButton" Style="{StaticResource IconButton}" ToolTip="最大化" Click="LockMaximize_Click">
                <TextBlock Text="&#xE922;" FontFamily="{DynamicResource IconFont}" FontSize="13"/>
            </Button>
            <Button x:Name="LockCloseButton" Style="{StaticResource IconButton}" ToolTip="关闭" Click="LockClose_Click">
                <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource IconFont}" FontSize="13"/>
            </Button>
        </StackPanel>
        <StackPanel x:Name="LockContent" HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
            <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource IconFont}" FontSize="34"
                       Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
            <TextBlock Text="应用已锁定" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            <TextBlock Text="输入应用密码继续使用" FontSize="12" Foreground="{DynamicResource TextTertiary}"
                       HorizontalAlignment="Center" Margin="0,6,0,18"/>
            <PasswordBox x:Name="LockBox" Height="40" FontSize="15" Padding="10,6,10,6" MaxLength="6"
                         Background="{DynamicResource SurfaceAlt}" Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource Border}" CaretBrush="{DynamicResource TextPrimary}"
                         KeyDown="LockBox_KeyDown"/>
            <UniformGrid x:Name="PinDots" Columns="6" Width="260" Height="34" Margin="0,0,0,18" HorizontalAlignment="Center" Visibility="Collapsed"/>
            <UniformGrid x:Name="PinPad" Columns="3" Width="270" Margin="0,0,0,14" Visibility="Collapsed"/>
            <TextBlock x:Name="LockError" FontSize="12" Foreground="{DynamicResource Danger}"
                       HorizontalAlignment="Center" Margin="0,8,0,10" Visibility="Collapsed"/>
            <Button x:Name="UnlockButton" Content="清除密码" Height="44" Margin="0,6,0,0" Click="Unlock_Click" Style="{StaticResource PrimaryButton}"/>
            <TextBlock Text="清除密码并退出登录" FontSize="11.5" Foreground="{DynamicResource TextTertiary}"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock x:Name="ResetPasswordLink" Text="重置密码（退出登录并取消密码）" Margin="0,14,0,0"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="11.5"
                       Cursor="Hand" MouseLeftButtonUp="ResetPassword_Click"/>
        </StackPanel>
    </Grid>
</Border>
<Border x:Name="SplashOverlay" Background="{DynamicResource AppBackground}" Panel.ZIndex="999">
    <Grid ClipToBounds="True">
        <Image x:Name="SplashBackdrop" Stretch="UniformToFill" Visibility="Collapsed" Opacity="0"/>
        <Border x:Name="SplashScrim" Background="#66000000" Visibility="Collapsed" Opacity="0"/>
        <Border x:Name="SplashGlow" Width="520" Height="520" CornerRadius="260"
                HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="SplashLogo" Width="84" Height="84" Opacity="0">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
                </Image.Effect>
            </Image>
            <TextBlock x:Name="SplashTitle" Text="TieLite" FontSize="30" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,18,0,0" Opacity="0"/>
            <TextBlock x:Name="SplashSubtitle" Text="桌面版" FontSize="13"
                       Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center"
                       Margin="0,6,0,0" Opacity="0"/>
            <ProgressBar x:Name="SplashBar" IsIndeterminate="True" Width="168" Height="3"
                         Margin="0,24,0,0" Opacity="0"/>
            <TextBlock x:Name="SplashStatus" Text="正在准备桌面…" FontSize="11.5"
                       Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center"
                       Margin="0,12,0,0" Opacity="0"/>
        </StackPanel>
    </Grid>
</Border>
</Grid>
</Window>
